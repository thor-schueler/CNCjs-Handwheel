#!/usr/bin/env node
'use strict';

// CNCjs <-> ESP32 pendant bridge.
//   pendant -> CNCjs : gcode lines (and a few realtime chars) read from the pendant's serial port
//   CNCjs -> pendant : status lines (state, MPos, WPos, feed/spindle) written to the pendant
//   Health/status of both links is exposed as JSON on http://127.0.0.1:8001/status (configurable).
//   Pendant logs can be accessed on http://127.0.0.1:8001/log (configurable)

// "install-service" / "uninstall-service": set up the systemd unit (and udev rule or Bluetooth binding), then exit
const subcommand = process.argv[2];
if (subcommand === 'install-service' || subcommand === 'uninstall-service') {
    require('../lib/service')(subcommand, process.argv.slice(3));
    return;
}

const fs = require('fs');
const os = require('os');
const path = require('path');
const http = require('http');
const { Command } = require('commander');
const { SerialPort } = require('serialport');
const connectToCncjs = require('../index');
const pkg = require('../package.json');

const DEFAULT_CONFIG_FILE = path.join(os.homedir(), '.cncjs-handwheel.config');

const DEFAULTS = {
    cncjs: {
        port: null,                // CNC controller port AS KNOWN TO CNCjs (e.g. /dev/ttyUSB0), NOT the pendant
        baudrate: 115200,
        controllerType: 'Grbl',    // Grbl | Smoothie (TinyG: state is not mapped yet)
        socketAddress: 'localhost',
        socketPort: 8000,
        accessTokenLifetime: '30d',
        retryInterval: 5000,       // ms before a failed or lost port open is retried (0 = never)
        openTimeout: 5000,         // ms to wait for CNCjs to answer an open request
        maxOpenTries: 3,           // unanswered open requests before the connection to CNCjs is rebuilt
        keepaliveMs: 30000,        // repeat the open request this often to verify the attachment (0 = off)
        reopenOnClose: true        // reopen the CNC port when it gets closed (e.g. from the CNCjs UI)
    },
    device: {
        path: '/dev/pendant',      // the pendant's serial port (e.g. /dev/ttyACM0 or /dev/rfcomm0)
        baudRate: 115200,
        reconnectMs: 3000,
        settleMs: 2000,            // ignore pendant input this long after opening the port
        send: true,                // false: never write anything to the pendant (status, PONG, ERR)

        // Modem-control lines. The CH340 + auto-reset transistors wire DTR/RTS to EN/IO0, so on Linux
        // the DTR/RTS toggling around open/close can reset the ESP32 or drop it into download mode.
        hupcl: false,              // do NOT drop DTR/RTS when the port is closed
        dtr: null,                 // true/false = force DTR right after open, null = leave alone
        rts: null                  // true/false = force RTS right after open, null = leave alone
    },
    status: {
        format: 'grbl',            // 'grbl' -> <Idle|MPos:..|WPos:..|FS:..>   'json' -> {"t":"status",...}
        intervalMs: 400,           // unsolicited status line at least this often (also the pendant's "host alive" signal)
        minGapMs: 350,             // minimum gap between two status lines (about 3 per second at most)
        pollAfterCommand: true,    // ask CNCjs/Grbl for a fresh status report after every pendant command
        decimals: 3
    },
    http: { enabled: true, host: '127.0.0.1', port: 8001 },
    
    // translate (Grbl 1.1 only): rewrite "G21G91X+10F2000" into "$J=G21G91X+10F2000" so a pendant jog does not
    // leave CNCjs/Grbl stuck in relative mode (and so jogs go through Grbl's jog queue)
    // maxInFlight: at most this many gcode lines handed to CNCjs and not yet answered with ok/error. While the
    //   limit is reached, jogs on the same axis and feed are merged into one longer jog (0 = no limit, no merging)
    // stallMs: if nothing is acknowledged for this long, assume lines were lost and start counting afresh
    // echo: tag jog lines sent to CNCjs with {echo: false} in their context. CNCjs passes the context on in its
    //   'serialport:write' event, so a console widget can skip them (see README); it changes nothing else
    jog: { translate: true, maxInFlight: 4, stallMs: 2000, echo: false },
    
    // pendant console lines ("; ...") are kept here for the widget instead of being sent to Grbl
    log: { max: 500 },

    verbose: false,            // -v: log pendant events and commands
    trace: false               // --trace: also log all controller traffic (everything CNCjs reads/writes)
};

// ---------------------------------------------------------------- config
const program = new Command();
program
    .name('cncjs-handwheel')
    .version(pkg.version)
    .option('-l, --list', 'list available serial ports then exit')
    .option('-c, --config <file>', 'config file (default: ' + DEFAULT_CONFIG_FILE + ' if present)')
    .option('-s, --secret <secret>', 'CNCjs secret (default: $CNCJS_SECRET or ~/.cncrc)')
    .option('-p, --port <port>', 'CNC controller port as known to CNCjs, e.g. /dev/ttyUSB0')
    .option('-b, --baudrate <baudrate>', 'CNC controller baud rate')
    .option('--controller-type <type>', 'Grbl|Smoothie')
    .option('--socket-address <address>', 'CNCjs host')
    .option('--socket-port <port>', 'CNCjs port')
    .option('--pendant-port <path>', 'serial port of the pendant')
    .option('--pendant-baudrate <baudrate>', 'baud rate of the pendant')
    .option('-v, --verbose', 'log pendant events and the commands sent to CNCjs')
    .option('--trace', 'also log all controller traffic (very noisy)')
    .option('--no-pendant-send', 'do not write anything to the pendant (same as device.send: false)')
    .option('--no-jog-translate', 'send pendant jogs as plain gcode instead of $J= (same as jog.translate: false)');
program.parse(process.argv);
const cli = program.opts();

/**
 * Tells whether a value is a plain object (not null, not an array).
 *
 * @param {*} v - value to test
 * @returns {boolean}
 */
const isObj = (v) => v && typeof v === 'object' && !Array.isArray(v);
/**
 * Recursively merges `extra` into a copy of `base`. Plain objects are merged key by key,
 * everything else (including arrays) is replaced. Neither argument is modified.
 *
 * @param {object} base - lower precedence values
 * @param {object} [extra] - higher precedence values
 * @returns {object} the merged copy
 */
const deepMerge = (base, extra) => {
    const out = Object.assign({}, base);
    Object.keys(extra || {}).forEach((k) => {
        out[k] = isObj(extra[k]) && isObj(base[k]) ? deepMerge(base[k], extra[k]) : extra[k];
    });
    return out;
};

if (cli.list) {
    SerialPort.list().then((ports) => {
        ports.forEach((p) => console.log([p.path, p.manufacturer, p.vendorId && (p.vendorId + ':' + p.productId)]
            .filter(Boolean).join('  ')));
    }).catch((err) => { console.error(err); process.exit(1); });
    return;
}

// precedence (low -> high): defaults, "pendant" section of ~/.cncrc, config file, CLI
let cfg = deepMerge(DEFAULTS, connectToCncjs.readCncrc().pendant);
const cfgFile = cli.config || (fs.existsSync(DEFAULT_CONFIG_FILE) ? DEFAULT_CONFIG_FILE : null);
if (cfgFile) {
    try {
        cfg = deepMerge(cfg, JSON.parse(fs.readFileSync(cfgFile, 'utf8')));
    } catch (err) {
        console.error('Cannot read config file ' + cfgFile + ': ' + err.message);
        process.exit(1);
    }
}
if (cli.port) cfg.cncjs.port = cli.port;
if (cli.baudrate) cfg.cncjs.baudrate = cli.baudrate;
if (cli.controllerType) cfg.cncjs.controllerType = cli.controllerType;
if (cli.socketAddress) cfg.cncjs.socketAddress = cli.socketAddress;
if (cli.socketPort) cfg.cncjs.socketPort = cli.socketPort;
if (cli.pendantPort) cfg.device.path = cli.pendantPort;
if (cli.pendantBaudrate) cfg.device.baudRate = cli.pendantBaudrate;
if (cli.verbose) cfg.verbose = true;
if (cli.trace) cfg.trace = true;
if (cli.pendantSend === false) cfg.device.send = false;
if (cli.jogTranslate === false) cfg.jog.translate = false;

if (!cfg.cncjs.port) { console.error('Missing CNC controller port (cncjs.port / --port)'); process.exit(1); }
if (!cfg.device.path) { console.error('Missing pendant port (device.path / --pendant-port). Try --list'); process.exit(1); }

// ---------------------------------------------------------------- state
const store = { controller: { state: {}, settings: {} }, sender: { status: {} } };

const health = {
    startedAt: Date.now(),
    pendant: { path: cfg.device.path, connected: false, lastRx: null, lastTx: null, rxLines: 0, txLines: 0,
        reconnects: 0, errors: 0, lastError: null, logLines: 0, garbageLines: 0 },
    cncjs: { socketConnected: false, portOpen: false, port: cfg.cncjs.port, controllerType: cfg.cncjs.controllerType,
        lastError: null, droppedCommands: 0 },
    jog: { sent: 0, merged: 0, discarded: 0, stalls: 0, inFlight: 0, held: false },
    lastCommand: null
};

/**
 * Logs to the console, but only when -v / verbose is on.
 *
 * @param {...*} args - what to print
 * @returns {void}
 */
const log = (...args) => cfg.verbose && console.log(...args);
let shuttingDown = false;

// ---------------------------------------------------------------- CNCjs side
const cncOpts = Object.assign({}, cfg.cncjs, { secret: cli.secret, verbose: cfg.trace });
const socket = connectToCncjs(cncOpts, (err) => {
    if (err) {
        health.cncjs.lastError = err.message;
        console.error(err.message);
    }
});

socket.on('connect', () => { health.cncjs.socketConnected = true; });
socket.on('disconnect', () => { health.cncjs.socketConnected = false; health.cncjs.portOpen = false; resetJogs(); });
socket.on('serialport:read', onControllerLine);
socket.on('serialport:open', () => {
    if (!health.cncjs.portOpen) { lastWco = null; resetJogs(); } // a keepalive confirmation must not discard the work offset
    health.cncjs.portOpen = true;
    health.cncjs.lastError = null;
});
socket.on('serialport:close', () => { health.cncjs.portOpen = false; resetJogs(); });

['Grbl', 'Smoothie', 'TinyG'].forEach((type) => {
    let dumped = false;
    socket.on(type + ':state', (state) => {
        store.controller.state = state || {};
        const wco = state && state.status && state.status.wco;
        if (wco) lastWco = wco;
        sendStatus(false); // forward changes right away (rate limited by status.minGapMs)
        if (cfg.verbose && !dumped) { dumped = true; console.log(type + ':state sample', JSON.stringify(state)); }
    });
    socket.on(type + ':settings', (settings) => { store.controller.settings = settings || {}; });
});

socket.on('sender:status', (data) => { store.sender.status = data || {}; });

let lastWco = null; // Grbl 1.1 only reports MPos *or* WPos, plus WCO now and then: WPos = MPos - WCO
/**
 * Tells whether commands can currently reach the CNC controller
 * (CNCjs socket connected and the CNC port open).
 *
 * @returns {boolean}
 */
const cncReady = () => socket.connected && health.cncjs.portOpen;

/**
 * Records and reports a command that could not be sent (at most one console line per second).
 *
 * @param {string} name - the CNCjs command that was dropped
 * @param {Array} args - its arguments
 * @returns {void}
 */
let lastDropWarn = 0;
const fmtArgs = (args) => args.map((a) => (a !== null && typeof a === 'object' ? JSON.stringify(a) : a));
function noteDropped(name, args) {
    health.cncjs.droppedCommands++;
    const now = Date.now();
    if (now - lastDropWarn < 1000) return;
    lastDropWarn = now;
    console.warn('Dropped pendant command (' + [name].concat(fmtArgs(args)).join(' ') + '): ' +
        (socket.connected ? 'the CNC port is not open' : 'not connected to CNCjs') +
        ' [' + health.cncjs.droppedCommands + ' dropped so far]');
}

/**
 * Sends a command to the CNC controller through CNCjs and answers the pendant with a status line.
 * If CNCjs or the CNC port is not ready the command is dropped and the pendant gets
 * `ERR:CNCJS_NOT_READY` plus a status line.
 *
 * @param {string} name - CNCjs command, e.g. 'gcode', 'feedhold', 'cyclestart', 'reset'
 * @param {...*} args - command arguments, e.g. the gcode line
 * @returns {boolean} true if the command was sent
 */
function sendCommand(name, ...args) {
    if (!cncReady()) {
        noteDropped(name, args);
        sendToPendant('ERR:CNCJS_NOT_READY');
        queueStatus();
        return false;
    }
    health.lastCommand = { at: Date.now(), name, args };
    log('pendant ->', name, ...fmtArgs(args));
    if (!socket.emit('command', cfg.cncjs.port, name, ...args)) {
        noteDropped(name, args);
        return false;
    }
    answerCommand();
    return true;
}

// Every command from the pendant is answered with a status line right away. The position in it is
// what CNCjs knew at that moment; a fresh report is requested so the real position follows within
// a few tens of ms (forwarded by the :state handler).
let lastPoll = 0;
/**
 * Answers a command from the pendant with a status line (within status.minGapMs, so a burst of
 * commands does not flood the pendant), and asks the controller for a fresh status report (at most
 * once per status.minGapMs) so the new position follows shortly after.
 *
 * @returns {void}
 */
function answerCommand() {
    queueStatus();
    const now = Date.now();
    if (cfg.status.pollAfterCommand && now - lastPoll >= Math.max(50, cfg.status.minGapMs)) {
        lastPoll = now;
        socket.emit('command', cfg.cncjs.port, 'statusreport');
    }
}

// ---------------------------------------------------------------- pendant -> CNCjs
// Everything from the pendant is LINE based (newline terminated) and must be printable ASCII.
// Lines that contain anything else are dropped (an ESP32 that is booting or running at the wrong
// baud rate spews binary garbage, which must never reach the CNC).
//   "!"  feed hold    "~"  cycle start    "^X" (0x18)  soft reset    "?"  status request
//   each as a line of its own, e.g. "!\n". Reset is rate limited.
//   ";..."  pendant console log entry (any text, ANSI colours stripped): kept in a ring buffer for the
//           widget (GET /log), never sent to CNCjs; with -v it is printed as "pendant log: ..."
//   lines dropped as non-text are reported with -v (escaped, at most one per second)
//   PING -> PONG,  STATUS? -> immediate status line
//   anything else -> gcode
// After the pendant port opens, input is ignored for device.settleMs so the boot output of an
// ESP32 that was reset by the open is discarded.
const logBuf = [];
let logSeq = 0;

/**
 * Appends a pendant console line to the ring buffer served at GET /log (capped at log.max entries).
 *
 * @param {string} text - the log text, without the leading ';'
 * @returns {void}
 */
function addPendantLog(text) {
    logBuf.push({ id: ++logSeq, t: Date.now(), text });
    if (logBuf.length > cfg.log.max) logBuf.splice(0, logBuf.length - cfg.log.max);
    health.pendant.logLines = logSeq;
    log('pendant -> log:', text);
}

const PRINTABLE = /^[\x20-\x7e]+$/;
const REALTIME = { '!': 'feedhold', '~': 'cyclestart', '\x18': 'reset' };
let rxBuf = '';
let skipLine = false;
let ignoreUntil = 0;
let lastReset = 0;

/**
 * Handler for raw bytes from the pendant's serial port. Splits the stream into lines, drops overlong
 * lines, and ignores everything during the settle time after the port was opened.
 *
 * @param {Buffer} buf - chunk read from the serial port
 * @returns {void}
 */
function onPendantData(buf) {
    const now = Date.now();
    health.pendant.lastRx = now;
    if (now < ignoreUntil) {
        rxBuf = '';
        skipLine = false;
        return;
    }
    const text = buf.toString('binary');
    for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (ch === '\n' || ch === '\r') {
            const line = rxBuf.trim();
            const drop = skipLine;
            rxBuf = '';
            skipLine = false;
            if (drop) health.pendant.garbageLines++;
            else if (line) onPendantLine(line);
        } else if (rxBuf.length < 256) {
            rxBuf += ch;
        } else {
            skipLine = true; // overlong line: drop it up to the next newline
        }
    }
}

// Only modal words (G20/G21/G90/G91), axis words and a feed, no G0/G1/G2/G3 -> this is a jog.
const JOG_RE = /^(?:G(?:20|21|90|91))+(?:[XYZABC][-+]?\d*\.?\d+|F\d*\.?\d+)+$/;

/**
 * Turns a pendant jog such as `G21G91X+10F2000` into a Grbl jog command (`$J=G21G91X+10F2000`).
 * Lines that are not pure jogs (no axis word, or containing G0/G1/G2/G3 etc.) are returned unchanged.
 *
 * @param {string} line - gcode line from the pendant
 * @returns {string} the jog command, or the original line
 */
function toJog(line) {
    const compact = line.replace(/\s+/g, '').toUpperCase();
    return JOG_RE.test(compact) && /[XYZABC]/.test(compact) ? '$J=' + compact : line;
}

const ANSI = /\x1b\[[0-9;]*[A-Za-z]/g;
let lastDropLog = 0;

/**
 * Counts a rejected (non-text) pendant line and, with -v, reports it escaped (at most once a second).
 *
 * @param {string} raw - the rejected line as received (binary string)
 * @returns {void}
 */
function dropLine(raw) {
    health.pendant.garbageLines++;
    const now = Date.now();
    if (cfg.verbose && now - lastDropLog > 1000) {
        lastDropLog = now;
        console.log('pendant: dropped non-text line', JSON.stringify(raw.slice(0, 60)));
    }
}

/**
 * Handles one complete line from the pendant: realtime commands (! ~ ^X ?), console log entries
 * (; ...), PING / STATUS?, and otherwise gcode (jogs are translated to $J= for Grbl).
 *
 * @param {string} raw - the line without the line terminator (binary string)
 * @returns {void}
 */
function onPendantLine(raw) {
    health.pendant.rxLines++;
    if (raw === '?') return sendStatus(true);
    if (REALTIME[raw]) {
        if (raw === '\x18') {
            const now = Date.now();
            if (now - lastReset < 2000) return;
            lastReset = now;
        }
        // stop means stop: jogs still held back must not fire after a feed hold or a reset
        if (raw === '!' || raw === '\x18') discardHeldJog();
        if (raw === '\x18') jog.inFlight = 0; // a soft reset flushes everything Grbl had not answered yet
        return sendCommand(REALTIME[raw]);
    }
    // decode as UTF-8, drop ANSI colour codes, tabs -> spaces
    let line = Buffer.from(raw, 'binary').toString('utf8').replace(ANSI, '').replace(/\t/g, ' ').trim();
    if (!line) return;
    if (line[0] === ';') {
        // console log entry from the pendant: any text is fine, it is never sent to the controller
        addPendantLog(line.replace(/^;\s?/, '').replace(/[\x00-\x1f\x7f]/g, ''));
        return;
    }
    if (!PRINTABLE.test(line)) {
        dropLine(raw);
        return;
    }
    const upper = line.toUpperCase();
    if (upper === 'PING') return sendToPendant('PONG');
    if (upper === 'STATUS?') return sendStatus(true);
    if (cfg.jog.translate && cfg.cncjs.controllerType === 'Grbl') {
        line = toJog(line);
    }
    sendGcodeLine(line);
}

// ---------------------------------------------------------------- jog governor
// CNCjs hands every gcode line it is given to Grbl without waiting for the previous one to be
// answered. Grbl only has a 128 byte serial buffer (about 6 jog lines), and stops reading it while its
// planner is full, so a fast wheel makes it lose characters: jogs vanish or turn into garbage.
// The bridge therefore counts the lines it has handed to CNCjs minus the ok / error replies it sees,
// and while jog.maxInFlight is reached it merges further jogs (same axis, feed and relative mode;
// opposite directions cancel out) into one pending jog that is sent as soon as a reply frees a slot.
const jog = { inFlight: 0, lastAck: 0, pending: null };
const JOG_PARTS = /^\$J=((?:G(?:20|21|90|91))+)([XYZABC])([-+]?\d*\.?\d+)F(\d*\.?\d+)$/;

/**
 * Splits a single-axis relative Grbl jog (`$J=G21G91Y-0.1F2000`) into its parts.
 *
 * @param {string} line - gcode line, already translated by toJog()
 * @returns {?{raw: string, prefix: string, axis: string, dist: number, feed: string}} null if the line
 *   is not a jog that can be merged with others
 */
function parseJog(line) {
    const m = JOG_PARTS.exec(line);
    if (!m) return null;
    const words = m[1].match(/G\d+/g);
    if (!words.includes('G91') || words.includes('G90')) return null;
    return { raw: line, prefix: m[1], axis: m[2], dist: Number(m[3]), feed: m[4] };
}

/**
 * Formats a signed jog distance without floating point noise, e.g. -0.1, +0.3, +10.
 *
 * @param {number} d - distance
 * @returns {string}
 */
function fmtDist(d) {
    const s = Math.abs(d).toFixed(4).replace(/\.?0+$/, '');
    return (d < 0 ? '-' : '+') + (s || '0');
}

/**
 * Sends a gcode line to CNCjs and counts it as unanswered (when the jog governor is on). Jogs ($J=)
 * carry `{echo: false}` as context when jog.echo is off.
 *
 * @param {string} line - the gcode line
 * @returns {boolean} true if the line was sent
 */
function writeGcode(line) {
    const quiet = !cfg.jog.echo && /^\$J=/.test(line);
    if (!(quiet ? sendCommand('gcode', line, { echo: false }) : sendCommand('gcode', line))) return false;
    if (cfg.jog.maxInFlight > 0) {
        if (jog.inFlight === 0) jog.lastAck = Date.now();
        jog.inFlight++;
        health.jog.inFlight = jog.inFlight;
    }
    health.jog.sent++;
    return true;
}

/**
 * Sends a gcode line from the pendant: jogs go through the governor, everything else goes straight
 * out (after any held back jog, to keep the order).
 *
 * @param {string} line - the gcode line
 * @returns {boolean} true if the line was sent or held back
 */
function sendGcodeLine(line) {
    const j = cfg.jog.maxInFlight > 0 ? parseJog(line) : null;
    if (j) return queueJog(j);
    flushJog(true);
    return writeGcode(line);
}

/**
 * Adds a jog to the pending one (same axis, feed and mode: distances add up, opposite jogs cancel;
 * anything else replaces it) and sends it if there is room.
 *
 * @param {object} j - jog from parseJog()
 * @returns {boolean} true
 */
function queueJog(j) {
    const p = jog.pending;
    if (p && p.prefix === j.prefix && p.axis === j.axis && p.feed === j.feed) {
        p.dist += j.dist;
        p.raw = null;
        health.jog.merged++;
        if (Math.abs(p.dist) < 1e-9) jog.pending = null;
    } else {
        if (p) health.jog.discarded++;
        jog.pending = j;
    }
    flushJog(false);
    health.jog.held = !!jog.pending;
    return true;
}

/**
 * Sends the pending jog if the limit allows (or when forced).
 *
 * @param {boolean} force - send even if jog.maxInFlight is reached
 * @returns {void}
 */
function flushJog(force) {
    const p = jog.pending;
    if (!p) return;
    if (!force && jog.inFlight >= cfg.jog.maxInFlight) return;
    jog.pending = null;
    health.jog.held = false;
    writeGcode(p.raw || '$J=' + p.prefix + p.axis + fmtDist(p.dist) + 'F' + p.feed);
}

/**
 * Throws away a jog that is being held back (after a feed hold or reset).
 *
 * @returns {void}
 */
function discardHeldJog() {
    if (jog.pending) health.jog.discarded++;
    jog.pending = null;
    health.jog.held = false;
}

/**
 * Forgets all jog accounting (CNCjs connection or CNC port changed): nothing stale is replayed.
 *
 * @returns {void}
 */
function resetJogs() {
    jog.inFlight = 0;
    jog.pending = null;
    health.jog.inFlight = 0;
    health.jog.held = false;
}

/**
 * Handles a line CNCjs read from the controller: every ok / error reply frees a slot and may release
 * the held jog.
 *
 * @param {*} data - the line (string) as emitted by CNCjs
 * @returns {void}
 */
function onControllerLine(data) {
    const line = String(data === null || data === undefined ? '' : data).trim();
    if (line !== 'ok' && line.slice(0, 6).toLowerCase() !== 'error:') return;
    if (jog.inFlight > 0) jog.inFlight--;
    health.jog.inFlight = jog.inFlight;
    jog.lastAck = Date.now();
    flushJog(false);
    health.jog.held = !!jog.pending;
}

// Lines the controller never answers (lost in transit) would keep the counter up for good.
const jogTimer = setInterval(() => {
    if (jog.inFlight > 0 && Date.now() - jog.lastAck > cfg.jog.stallMs) {
        health.jog.stalls++;
        console.warn('Controller did not acknowledge ' + jog.inFlight + ' gcode line(s) for ' + cfg.jog.stallMs +
            ' ms: they may have been lost. [' + health.jog.stalls + ' stall(s) so far]');
        jog.inFlight = 0;
        health.jog.inFlight = 0;
    }
    flushJog(false);
}, 250);

// ---------------------------------------------------------------- CNCjs -> pendant
/**
 * Converts a value to a number, treating anything non-numeric as 0.
 *
 * @param {*} v
 * @returns {number}
 */
const num = (v) => Number(v) || 0;
/**
 * Subtracts two {x, y, z} positions (a - b).
 *
 * @param {{x: (number|string), y: (number|string), z: (number|string)}} a
 * @param {{x: (number|string), y: (number|string), z: (number|string)}} b
 * @returns {{x: number, y: number, z: number}}
 */
const sub = (a, b) => ({ x: num(a.x) - num(b.x), y: num(a.y) - num(b.y), z: num(a.z) - num(b.z) });
/**
 * Adds two {x, y, z} positions (a + b).
 *
 * @param {{x: (number|string), y: (number|string), z: (number|string)}} a
 * @param {{x: (number|string), y: (number|string), z: (number|string)}} b
 * @returns {{x: number, y: number, z: number}}
 */
const add = (a, b) => ({ x: num(a.x) + num(b.x), y: num(a.y) + num(b.y), z: num(a.z) + num(b.z) });

/**
 * Returns machine and work position. Grbl 1.1 reports only one of them plus the work coordinate
 * offset (WCO) now and then, so the missing one is derived: WPos = MPos - WCO.
 *
 * @param {object} st - the `status` object of the CNCjs controller state
 * @returns {{mpos: ?object, wpos: ?object}} positions, null where they cannot be determined yet
 */
function positions(st) {
    const wco = st.wco || lastWco;
    let mpos = st.mpos || null;
    let wpos = st.wpos || null;
    if (!wpos && mpos && wco) wpos = sub(mpos, wco);
    if (!mpos && wpos && wco) mpos = add(wpos, wco);
    return { mpos, wpos };
}

/**
 * Builds the current machine status from the latest CNCjs controller and sender state.
 *
 * @returns {{connected: boolean, state: string, mpos: ?object, wpos: ?object, feed: ?number,
 *   spindle: ?number, sender: object}}
 */
function snapshot() {
    const connected = cncReady();
    const st = (store.controller.state && store.controller.state.status) || {};
    const pos = positions(st);
    const snd = store.sender.status || {};
    return {
        connected,
        state: connected ? (st.activeState || 'Unknown') : 'Disconnected',
        mpos: pos.mpos,
        wpos: pos.wpos,
        feed: st.feedrate !== undefined ? st.feedrate : null,
        spindle: st.spindle !== undefined ? st.spindle : null,
        sender: { name: snd.name || null, total: snd.total || 0, sent: snd.sent || 0,
            received: snd.received || 0, hold: !!snd.hold }
    };
}

/**
 * Formats a status snapshot as the line sent to the pendant, either Grbl style
 * (`<Idle|MPos:x,y,z|WPos:x,y,z|FS:feed,spindle>`) or JSON, depending on status.format.
 *
 * @param {object} s - snapshot from snapshot()
 * @returns {string} the status line without terminator
 */
function formatStatus(s) {
    if (cfg.status.format === 'json') {
        return JSON.stringify(Object.assign({ t: 'status' }, s));
    }
    const d = cfg.status.decimals;
    const pos = (p) => [p.x, p.y, p.z].map((n) => (Number(n) || 0).toFixed(d)).join(',');
    const parts = [s.state];
    if (s.connected) {
        if (s.mpos) parts.push('MPos:' + pos(s.mpos));
        if (s.wpos) parts.push('WPos:' + pos(s.wpos));
        if (s.feed !== null) parts.push('FS:' + (Number(s.feed) || 0) + ',' + (Number(s.spindle) || 0));
    }
    return '<' + parts.join('|') + '>';
}

let lastLine = '';
let lastStatusAt = 0;
let statusQueued = false;

/**
 * Sends the current status to the pendant if one is due: forced, at least every status.intervalMs,
 * when the values changed and status.minGapMs has passed, or when one was queued with queueStatus().
 *
 * @param {boolean} [force=false] - send regardless of timing
 * @returns {void}
 */
function sendStatus(force) {
    if (!cfg.device.send) return;
    const line = formatStatus(snapshot());
    const now = Date.now();
    const gapOk = now - lastStatusAt >= cfg.status.minGapMs;
    const due = now - lastStatusAt >= cfg.status.intervalMs;
    const changed = line !== lastLine && gapOk;
    if (force || due || changed || (statusQueued && gapOk)) {
        if (sendToPendant(line, changed)) {
            lastLine = line;
            lastStatusAt = now;
            statusQueued = false;
        }
    }
}

/**
 * Asks for a status line to go to the pendant soon: now if status.minGapMs has passed since the last
 * one, otherwise as soon as it has (the periodic timer sends it). Many requests in a row cost one line.
 *
 * @returns {void}
 */
function queueStatus() {
    statusQueued = true;
    sendStatus(false);
}

/**
 * Writes one line to the pendant's serial port.
 *
 * @param {string} text - the line, without terminator (a newline is added)
 * @param {boolean} [should_log=false] - print the line when -v is on
 * @returns {boolean} false if the pendant port is not open
 */
function sendToPendant(text, should_log=false) {
    if (!cfg.device.send) return false;
    const port = pendantPort;
    if (!port || !port.isOpen) return false;
    if(should_log) log('cncjs -> ', 'pendant', text);
    port.write(text + '\n', (err) => {
        if (err) noteError(err);
    });
    health.pendant.lastTx = Date.now();
    health.pendant.txLines++;
    return true;
}

const statusTimer = setInterval(() => sendStatus(false), Math.max(10, Math.min(100, cfg.status.minGapMs, cfg.status.intervalMs)));

// ---------------------------------------------------------------- pendant serial link
let pendantPort = null;
let reconnectTimer = null;

/**
 * Records a pendant serial error in the health data and prints it.
 *
 * @param {Error} err
 * @returns {void}
 */
function noteError(err) {
    health.pendant.errors++;
    health.pendant.lastError = err.message;
    console.error('Pendant error:', err.message);
}

/**
 * Schedules a reopen of the pendant serial port after device.reconnectMs (at most one pending).
 *
 * @returns {void}
 */
function scheduleReconnect() {
    if (shuttingDown || reconnectTimer) return;
    reconnectTimer = setTimeout(() => {
        reconnectTimer = null;
        health.pendant.reconnects++;
        openPendant();
    }, cfg.device.reconnectMs);
}

/**
 * Opens the pendant's serial port and wires up its events. Failures and closes schedule a reconnect.
 * After a successful open, pendant input is ignored for device.settleMs and a status line is sent.
 *
 * @returns {void}
 */
function openPendant() {
    const port = new SerialPort({
        path: cfg.device.path,
        baudRate: Number(cfg.device.baudRate),
        autoOpen: false,
        dataBits: 8,
        stopBits: 1,
        parity: 'none',
        rtscts: false,
        xon: false,
        xoff: false,
        xany: false,
        hupcl: !!cfg.device.hupcl
    });
    pendantPort = port;
    port.on('data', onPendantData);
    port.on('error', noteError);
    port.on('close', () => {
        health.pendant.connected = false;
        if (!shuttingDown) console.log('Pendant port closed');
        scheduleReconnect();
    });
    port.open((err) => {
        if (err) {
            noteError(err);
            scheduleReconnect();
            return;
        }
        rxBuf = '';
        skipLine = false;
        ignoreUntil = Date.now() + Number(cfg.device.settleMs || 0);
        const lines = {};
        if (cfg.device.dtr !== null && cfg.device.dtr !== undefined) lines.dtr = !!cfg.device.dtr;
        if (cfg.device.rts !== null && cfg.device.rts !== undefined) lines.rts = !!cfg.device.rts;
        if (Object.keys(lines).length) {
            port.set(lines, (setErr) => { if (setErr) noteError(setErr); });
        }
        health.pendant.connected = true;
        health.pendant.lastError = null;
        console.log('Pendant connected on ' + cfg.device.path);
        sendStatus(true);
    });
}

// ---------------------------------------------------------------- health endpoint
/**
 * Builds the JSON served at GET /status: link health of the pendant and CNCjs, the last command
 * sent, and the current machine status.
 *
 * @returns {object}
 */
function healthReport() {
    const now = Date.now();
    const age = (t) => (t ? now - t : null);
    return {
        ok: health.pendant.connected && cncReady(),
        version: pkg.version,
        uptimeMs: now - health.startedAt,
        pendant: Object.assign({}, health.pendant, { sendEnabled: !!cfg.device.send, lastRxAgeMs: age(health.pendant.lastRx),
            lastTxAgeMs: age(health.pendant.lastTx) }),
        cncjs: health.cncjs,
        jog: health.jog,
        lastCommand: health.lastCommand,
        status: snapshot()
    };
}

let httpServer = null;
if (cfg.http.enabled) {
    httpServer = http.createServer((req, res) => {
        const url = new URL(req.url, 'http://localhost');
        const headers = { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' };
        if (url.pathname === '/' || url.pathname === '/status') {
            res.writeHead(200, headers);
            res.end(JSON.stringify(healthReport()));
        } else if (url.pathname === '/log') {
            // GET /log?since=<id> -> entries with id > since (poll with the last id you saw)
            const since = Number(url.searchParams.get('since')) || 0;
            res.writeHead(200, headers);
            res.end(JSON.stringify({ last: logSeq, entries: logBuf.filter((e) => e.id > since) }));
        } else {
            res.writeHead(404);
            res.end();
        }
    });
    httpServer.on('error', (err) => console.error('Health endpoint error:', err.message));
    httpServer.listen(cfg.http.port, cfg.http.host, () =>
        console.log('Health endpoint on http://' + cfg.http.host + ':' + cfg.http.port + '/status'));
}

// ---------------------------------------------------------------- lifecycle
/**
 * Stops timers and closes the CNCjs socket, the pendant port and the HTTP server, then exits.
 * Called on SIGINT / SIGTERM.
 *
 * @returns {void}
 */
function shutdown() {
    if (shuttingDown) return;
    shuttingDown = true;
    clearInterval(statusTimer);
    clearInterval(jogTimer);
    clearTimeout(reconnectTimer);
    socket.close();
    if (httpServer) httpServer.close();
    if (pendantPort && pendantPort.isOpen) pendantPort.close();
    setTimeout(() => process.exit(0), 300);
}
process.on('SIGINT', shutdown);
process.on('SIGTERM', shutdown);

openPendant();
