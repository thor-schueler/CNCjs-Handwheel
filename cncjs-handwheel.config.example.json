{
  "cncjs": {
    "port": "/dev/ttyUSB0",
    "baudrate": 115200,
    "controllerType": "Grbl",
    "socketAddress": "localhost",
    "socketPort": 8000
  },
  "device": {
    "path": "/dev/ttyACM0",
    "baudRate": 115200,
    "reconnectMs": 3000,
    "settleMs": 2000,
    "hupcl": false,
    "dtr": null,
    "rts": null
  },
  "status": {
    "format": "grbl",
    "intervalMs": 100,
    "minGapMs": 25,
    "pollAfterCommand": true
  },
  "http": { "enabled": true, "host": "127.0.0.1", "port": 8001 },
  "jog": { "translate": true },
  "log": { "max": 500 }
}
