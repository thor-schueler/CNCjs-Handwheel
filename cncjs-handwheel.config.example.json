{
  "cncjs": {
    "port": "/dev/ttyUSB0",
    "baudrate": 115200,
    "controllerType": "Grbl",
    "socketAddress": "localhost",
    "socketPort": 8000,
    "retryInterval": 5000,
    "openTimeout": 5000,
    "maxOpenTries": 3,
    "keepaliveMs": 30000,
    "reopenOnClose": true
  },
  "device": {
    "path": "/dev/pendant",
    "baudRate": 115200,
    "reconnectMs": 3000,
    "settleMs": 2000,
    "send": true,
    "hupcl": false,
    "dtr": null,
    "rts": null
  },
  "status": {
    "format": "grbl",
    "intervalMs": 400,
    "minGapMs": 350,
    "pollAfterCommand": false,
    "decimals": 3
  },
  "jog": {
    "translate": true,
    "maxInFlight": 4,
    "stallMs": 2000,
    "cancelSettleMs": 40,
    "echo": false
  },
  "http": { "enabled": true, "host": "127.0.0.1", "port": 8001 },
  "log": { "max": 500 }
}